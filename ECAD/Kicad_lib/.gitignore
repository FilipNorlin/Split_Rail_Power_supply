# KiCad project files to keep

!*.kicad_pro
!*.kicad_sch
!*.kicad_pcb
!*.kicad_mod
!*.lib
!*.dcm

# Ignore packed symbol libraries
*.kicad_sym

# Keep individual symbols in .kicad_symdir libraries
!*.kicad_symdir/
!*.kicad_symdir/**/*.kicad_sym

# But keep symbols inside symbol directories
!*.kicad_symdir/
!*.kicad_symdir/**/*.kicad_sym

# Project backup and autosave

*.bak
*.tmp
*~

# KiCad backup/autosave files

*.0001.kicad_sch
*.0001.kicad_pcb
*.autosave.kicad_pcb
*.autosave.kicad_sch

# User-specific settings (don't sync across machines)

*.kicad_prl
*.kicad_wks
*.kicad_dru
*.kicad_sav
fp-info-cache

# Simulation files

*.raw
*.log
*.cir
*.plt
*.net
*.cache
*.out
*.data
*.vcd
*.spice

